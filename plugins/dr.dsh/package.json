{
  "name": "@dr.dsh/dsh-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Install, configure and manage the local dr.dsh daemon from a DSH plugin",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "web",
    "native",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": "0.1.5-rc.2 || 0.1.6-alpha.2 || 0.1.7-rc.2 || 0.2.0-rc.2 || 0.2.1-alpha.2 || 0.2.1-rc.2 || 0.2.1-rc.5 || 0.2.2-alpha.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "node --test 'src/*.test.ts'"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.20.2"
  }
}
