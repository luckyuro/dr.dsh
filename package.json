{
  "name": "dr.dsh",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "dr.dsh — local-first remote access and control for DeepSeek Harness",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "drdsh": "node scripts/drdsh.mjs",
    "test:cli": "node --test scripts/drdsh.test.mjs scripts/package-plugin.test.mjs",
    "smoke:multicall": "node scripts/multicall-smoke.mjs",
    "smoke:release": "node scripts/release-installer-smoke.mjs",
    "smoke:transport": "node scripts/relay-transport-smoke.mjs",
    "smoke:relay-backpressure": "node scripts/relay-backpressure-smoke.mjs",
    "smoke:dsh-upgrade": "node scripts/dsh-upgrade-smoke.mjs",
    "smoke:notifications": "node scripts/plugin-notification-smoke.mjs",
    "smoke:daemon-management": "node scripts/daemon-management-smoke.mjs",
    "smoke:plugin-owner": "node scripts/plugin-owner-smoke.mjs",
    "smoke:doctor": "node scripts/doctor-smoke.mjs",
    "smoke:browser-management": "node scripts/browser-management-smoke.mjs",
    "smoke:frameworks": "node scripts/framework-validation-smoke.mjs",
    "smoke:services": "node scripts/service-smoke.mjs",
    "smoke:systemd": "node scripts/systemd-smoke.mjs",
    "build:rs": "cargo build --workspace",
    "check:rs": "pnpm run gen:vectors && cargo check --workspace --all-targets",
    "gen:vectors": "node scripts/ws-conformance.mjs",
    "test:rs": "pnpm run gen:vectors && cargo test --workspace",
    "lint:rs": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rs": "cargo fmt --all",
    "typecheck:ts": "pnpm -r --if-present run typecheck",
    "test:ts": "pnpm -r --if-present run test",
    "lint:imports": "node scripts/check-dsh-isolation.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "verify": "pnpm run check:rs && pnpm run lint:rs && pnpm run test:rs && pnpm run typecheck:ts && pnpm run test:ts && pnpm run test:cli && pnpm run lint:imports && pnpm run docs:check"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.20.2"
  }
}
